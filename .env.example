# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Replica Set Connection String
# For local Docker replica set (configured via docker-compose):
MONGODB_URI=mongodb://localhost:27017/ledger?replicaSet=rs0&directConnection=true

# For standalone or Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/ledger?retryWrites=true&w=majority

